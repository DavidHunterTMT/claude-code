<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Deliveries: Print > Delivery Slip in the gear menu, replacing the header button. -->
    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Deliveries: the four slips and Shipping Labels leave Print on done delivery orders. -->
    <function model="stock.picking" name="_tmt_set_print_menu_domains"/>

    <!-- Batches: Print > Batch Transfer is already in the gear menu; Print Labels joins it. -->
    <record id="action_batch_print_product_labels" model="ir.actions.server">
        <field name="name">Print Labels</field>
        <field name="model_id" ref="stock_picking_batch.model_stock_picking_batch"/>
        <field name="binding_model_id" ref="stock_picking_batch.model_stock_picking_batch"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_open_label_layout()
        </field>
    </record>

</odoo>
