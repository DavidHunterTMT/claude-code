<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_salary_rule_form_payroll_summary" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.payroll.summary</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='category_id'])[1]" position="after">
                <field name="payroll_summary_section" placeholder="Automatic (from category)"/>
            </xpath>
        </field>
    </record>
</odoo>
