<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_payroll_summary" model="report.paperformat">
        <field name="name">Payroll Summary (Letter Landscape)</field>
        <field name="format">Letter</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">12</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_payroll_summary" model="ir.actions.report">
        <field name="name">Payroll Summary</field>
        <field name="model">tmt.payroll.summary.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tmt_payroll_summary.report_payroll_summary</field>
        <field name="report_file">tmt_payroll_summary.report_payroll_summary</field>
        <field name="print_report_name">'Payroll Summary %s - %s' % (object.date_from.strftime('%m%d%y'), object.date_to.strftime('%m%d%y'))</field>
        <field name="paperformat_id" ref="paperformat_payroll_summary"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
