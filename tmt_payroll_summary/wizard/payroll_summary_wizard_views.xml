<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tmt_payroll_summary_wizard_form" model="ir.ui.view">
        <field name="name">tmt.payroll.summary.wizard.form</field>
        <field name="model">tmt.payroll.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Payroll Summary">
                <group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="date_basis"/>
                        <field name="include_unpaid" invisible="date_basis == 'paid_date'"/>
                    </group>
                    <group string="Filters">
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="employee_ids" widget="many2many_tags"
                               placeholder="All employees"/>
                        <field name="department_ids" widget="many2many_tags"
                               placeholder="All departments"/>
                    </group>
                    <group string="Options">
                        <field name="hide_zero_lines"/>
                        <field name="employees_per_page"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view" string="View" type="object" class="btn-primary"/>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-secondary"/>
                    <button name="action_export_xlsx" string="Export to Excel" type="object" class="btn-secondary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tmt_payroll_summary_wizard" model="ir.actions.act_window">
        <field name="name">Payroll Summary</field>
        <field name="res_model">tmt.payroll.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_tmt_payroll_summary"
              name="Payroll Summary"
              parent="hr_payroll.menu_hr_payroll_report"
              action="action_tmt_payroll_summary_wizard"
              groups="hr_payroll.group_hr_payroll_user"
              sequence="1"/>
</odoo>
